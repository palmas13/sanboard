# ==============================================================================
# SANBOARD – GTA WORLD CLASSIFIEDS PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Duplicate this file to .env.local for local development or set these variables
# in your Vercel Project Settings for staging / production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sanmail entegrasyonu için base URL (ör. webmail arayüzü linkleri).
# Gerçek URL kesinleştiğinde girilmelidir:
NEXT_PUBLIC_SANMAIL_BASE_URL=

# ------------------------------------------------------------------------------
# 2. DATA STORE & SUPABASE (PostgreSQL)
# - Yerel geliştirme için: DATA_STORE=memory (Supabase olmadan çalışır)
# - Gerçek staging için:   DATA_STORE=supabase (ve aşağıdaki key'ler girilir)
#
# NOT: Supabase'in yeni API key sistemi kullanılmaktadır.
# - Anon key yerine:         NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# - Service role key yerine: SUPABASE_SECRET_KEY
# ------------------------------------------------------------------------------
DATA_STORE=memory
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# (İSTEĞE BAĞLI / OPSİYONEL)
# SQL migration'lar doğrudan Supabase SQL Editor üzerinden çalıştırıldığı için
# uygulamanın normal runtime çalışması için DATABASE_URL ZORUNLU DEĞİLDİR.
# Yalnızca harici migration araçları veya doğrudan psql bağlantısı gerekiyorsa kullanılır:
# DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (Cloudflare R2 - S3 Compatible)
# - Yerel geliştirme için: USE_MOCK_STORAGE=true (base64 data-url kullanır)
# - Gerçek staging için:   USE_MOCK_STORAGE=false (ve aşağıdaki R2 bilgileri girilir)
# ------------------------------------------------------------------------------
USE_MOCK_STORAGE=true
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 4. GTA WORLD UCP / AUTH INTEGRATION
# - Resmi contract gelene kadar gerçek giriş fail-closed NOT_CONFIGURED durumundadır.
# - Endpoint, scope, token ve payload env'leri resmi sözleşme gelince tanımlanacaktır.
# - Gerçek giriş yolu hiçbir zaman test provider'a fallback yapmaz.
# - Geçici test-character harness yalnız ENABLE_TEST_LOGIN=true ile ayrıca açılır.
# - Canonical test hesaplarının ödeme bypass'ı girişten bağımsız olarak
#   ENABLE_TEST_PAYMENT_BYPASS=true ile açılır; production kullanıcıları kapsamaz.
# ------------------------------------------------------------------------------
ENABLE_TEST_LOGIN=true
ENABLE_TEST_PAYMENT_BYPASS=false

# ------------------------------------------------------------------------------
# 5. FLEECA PAYMENT INTEGRATION
# - Resmi contract gelene kadar gerçek provider fail-closed NOT_CONFIGURED durumundadır.
# - Endpoint, credential, webhook ve signature env'leri resmi sözleşme gelince tanımlanacaktır.
# - Normal checkout hiçbir zaman test provider'a fallback yapmaz.
# - Test provider yalnız test süreci tarafından ENABLE_TEST_PAYMENTS=true ile açıkça kullanılabilir.
# ------------------------------------------------------------------------------
ENABLE_TEST_PAYMENTS=false
USE_MOCK_FLEECA=false
FLEECA_API_KEY=
# 0=sandbox, 1=live
FLEECA_MODE=0

# ------------------------------------------------------------------------------
# 6. SECURITY & SESSION SIGNING (HMAC-SHA256)
# - Sunucu tarafında oturum çerezlerini (sanboard_session) imzalamak için kullanılır.
# - En az 32 byte (64 hex karakter) güçlü rastgele gizli anahtar girilmelidir.
# - Tarayıcıya kesinlikle açılmaz (NEXT_PUBLIC_ içermez).
# - Staging ve Production için zorunludur:
# ------------------------------------------------------------------------------
SANBOARD_SESSION_SECRET=

# Scheduler-only bearer secret for protected /api/internal/* worker routes.
# Use an independent random value of at least 32 characters.
LIFECYCLE_CRON_SECRET=
# Vercel Cron and GitHub Actions send this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
